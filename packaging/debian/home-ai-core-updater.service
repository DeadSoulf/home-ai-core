[Unit]
Description=Home-AI-Core bundle updater helper
Documentation=https://github.com/DeadSoulf/home-ai-core
After=local-fs.target
Before=home-ai-core.service

[Service]
Type=simple
ExecStart=/usr/libexec/home-ai-core/home-ai-core-updater
User=root
Group=root
Restart=always
RestartSec=1s
TimeoutStopSec=10s
EnvironmentFile=-/etc/home-ai-core/home-ai-core.env
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# HTTP health checks connect only to managed Docker module IPs on the private bridge.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
