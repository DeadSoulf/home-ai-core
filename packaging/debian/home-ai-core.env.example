# Home-AI-Core service overrides.
# Mutable product settings will eventually be managed through the Core API.

HOME_AI_LISTEN=0.0.0.0:82
HOME_AI_STATE_DIR=/var/lib/home-ai-core
HOME_AI_WEB_DIR=/usr/share/home-ai-core/web

# The official module catalog is public. No GitHub token is needed to read it.
# Public GHCR images are pulled anonymously.
# Optional: configure credentials only for private GHCR images; use a
# GitHub token with read:packages (and repo if private repo access is required).
# HOME_AI_MODULE_CATALOG_TOKEN=
# HOME_AI_MODULE_REGISTRY_USER=DeadSoulf
