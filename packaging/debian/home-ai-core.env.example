# Home-AI-Core service overrides.
# Mutable product settings will eventually be managed through the Core API.

HOME_AI_LISTEN=0.0.0.0:8080
HOME_AI_STATE_DIR=/var/lib/home-ai-core
HOME_AI_WEB_DIR=/usr/share/home-ai-core/web

# Optional local AI provider. Leave empty to keep chat disabled.
# Example:
# HOME_AI_AI_PROVIDER=ollama
# HOME_AI_AI_ENDPOINT=http://127.0.0.1:11434
# HOME_AI_AI_MODEL=qwen3:8b

# Optional Cloud AI module (OpenAI-compatible Chat Completions API).
# The module is registered disabled by default. Configure all three values,
# restart Home-AI-Core, then enable "Cloud AI" on the Modules page.
# Keep this file readable only by the service account/root because it contains a secret.
# Example:
# HOME_AI_CLOUD_AI_ENDPOINT=https://api.example.com/v1
# HOME_AI_CLOUD_AI_MODEL=your-model
# HOME_AI_CLOUD_AI_API_KEY=replace-with-secret
