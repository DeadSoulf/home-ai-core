# Home-AI-Core service overrides.
# Mutable product settings will eventually be managed through the Core API.

HOME_AI_LISTEN=0.0.0.0:8080
HOME_AI_STATE_DIR=/var/lib/home-ai-core
HOME_AI_WEB_DIR=/usr/share/home-ai-core/web

# Private official module catalog and GHCR package access.
# Use a GitHub Personal Access Token (classic) with repo + read:packages for the private official catalog and GHCR.
HOME_AI_MODULE_CATALOG_TOKEN=
HOME_AI_MODULE_REGISTRY_USER=DeadSoulf
