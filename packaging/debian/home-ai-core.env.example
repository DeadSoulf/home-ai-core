# Home-AI-Core bootstrap overrides.
# Mutable product settings will eventually be managed through the Core API.

HOME_AI_LISTEN=127.0.0.1:8080
HOME_AI_STATE_DIR=/var/lib/home-ai-core
HOME_AI_WEB_DIR=/usr/share/home-ai-core/web

# Optional local AI provider. Leave empty to keep chat disabled.
# Example:
# HOME_AI_AI_PROVIDER=ollama
# HOME_AI_AI_ENDPOINT=http://127.0.0.1:11434
# HOME_AI_AI_MODEL=qwen3:8b
