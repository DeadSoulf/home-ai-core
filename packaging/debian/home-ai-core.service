[Unit]
Description=Home-AI-Core control plane
Documentation=https://github.com/DeadSoulf/home-ai-core
After=network.target home-ai-core-update-helper.service
Wants=network.target home-ai-core-update-helper.service

[Service]
Type=simple
User=home-ai-core
Group=home-ai-core

Environment=HOME_AI_LISTEN=127.0.0.1:8080
Environment=HOME_AI_STATE_DIR=/var/lib/home-ai-core
Environment=HOME_AI_WEB_DIR=/usr/share/home-ai-core/web
EnvironmentFile=-/etc/home-ai-core/home-ai-core.env

ExecStart=/usr/bin/home-ai-core
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

StateDirectory=home-ai-core
StateDirectoryMode=0700
RuntimeDirectory=home-ai-core
RuntimeDirectoryMode=0700
ConfigurationDirectory=home-ai-core
ConfigurationDirectoryMode=0750
WorkingDirectory=/var/lib/home-ai-core
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
