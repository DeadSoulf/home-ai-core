{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-ai-core.local/schemas/module-manifest-v2.schema.json",
  "title": "Home-AI-Core Module Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "core", "runtime", "lifecycle"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"$ref": "#/$defs/moduleId"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 1024},
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "core": {"type": "string", "minLength": 1},
    "runtime": {"$ref": "#/$defs/runtime"},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/moduleId"}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/namespacedName"}},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "host": {"$ref": "#/$defs/host"},
    "api": {"$ref": "#/$defs/api"},
    "events": {"$ref": "#/$defs/events"},
    "ui": {"$ref": "#/$defs/ui"},
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["install", "upgrade", "remove", "backup", "restore", "start", "stop", "restart"]}
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "namespacedName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "docker"],
      "properties": {
        "type": {"const": "docker"},
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": {
              "type": "string",
              "maxLength": 520,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,447}@sha256:[a-f0-9]{64}$"
            }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "path": {"type": "string", "pattern": "^/.*", "maxLength": 256}
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/moduleId"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "contains": {"const": "host.docker"},
          "items": {"$ref": "#/$defs/namespacedName"}
        },
        "provides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/namespacedName"}
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["amd64", "arm64"]}
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"namespace": {"$ref": "#/$defs/moduleId"}}
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publishes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/namespacedName"}},
        "subscribes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"navigation": {"type": "array", "items": {"$ref": "#/$defs/navigation"}}}
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "route"],
      "properties": {
        "id": {"$ref": "#/$defs/moduleId"},
        "title": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1},
        "icon": {"type": "string"},
        "order": {"type": "integer"}
      }
    }
  }
}
