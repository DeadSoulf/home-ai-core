{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-ai-core.local/schemas/module-manifest-v1.schema.json",
  "title": "Home-AI-Core Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "core", "lifecycle"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 1024},
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "core": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependency"}
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/moduleId"}
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/namespacedName"}
    },
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "host": {"$ref": "#/$defs/host"},
    "api": {"$ref": "#/$defs/api"},
    "events": {"$ref": "#/$defs/events"},
    "ui": {"$ref": "#/$defs/ui"},
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["install", "upgrade", "remove", "backup", "restore"]
      }
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "namespacedName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/moduleId"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/namespacedName"}
        },
        "provides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/namespacedName"}
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["amd64", "arm64"]}
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {"$ref": "#/$defs/moduleId"}
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publishes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/namespacedName"}
        },
        "subscribes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "type": "array",
          "items": {"$ref": "#/$defs/navigation"}
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "route"],
      "properties": {
        "id": {"$ref": "#/$defs/moduleId"},
        "title": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1},
        "icon": {"type": "string"},
        "order": {"type": "integer"}
      }
    }
  }
}
